---
/**
 * Anti-flash theme init: runs before first paint so the stored (or OS)
 * theme applies immediately. Same storage key on every route — one
 * source of truth for what "dark" means.
 */
---

<script is:inline>
  (() => {
    const stored = typeof localStorage !== "undefined" && localStorage.getItem("starlight-theme");
    const theme = stored ?? "light";
    document.documentElement.dataset.theme = theme === "dark" ? "dark" : "light";
  })();
</script>
