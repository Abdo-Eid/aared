---
/** Note callout: rounded card, tinted accent fill — matches blockquote styling. */
---

<div class="note">
  <slot />
</div>

<style>
  .note {
    margin: 1.25rem 0;
    padding: 0.9rem 1.25rem;
    border: 1px solid color-mix(in srgb, var(--lt-accent) 22%, transparent);
    background: color-mix(in srgb, var(--lt-accent) 9%, transparent);
    color: var(--lt-ink);
    font-size: 0.95rem;
    line-height: 1.6;
    border-radius: var(--docs-radius, 16px);
  }
  .note > :first-child {
    margin-top: 0;
  }
  .note > :last-child {
    margin-bottom: 0;
  }
</style>
