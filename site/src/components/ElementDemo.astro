---
import Picker from "./Picker.astro";
import type { DemoFixture } from "../lib/demo-frame.js";

interface Props {
  fixtures: DemoFixture[];
}

const { fixtures } = Astro.props;
---

<div class="demo-frame" data-element-demo data-initial={fixtures[0]?.url ?? ""}>
  <Picker fixtures={fixtures} />
  <p data-status data-state="idle">Pick a fixture to begin.</p>
  <div data-stage data-state="idle" class="demo-stage"></div>
</div>

<script>
  import { attachDemo } from "../lib/demo-frame.ts";
  import { runElementDemo } from "../demos/element.ts";

  for (const frame of document.querySelectorAll<HTMLElement>("[data-element-demo]")) {
    attachDemo(frame, () => runElementDemo);
  }
</script>
