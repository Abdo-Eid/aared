---
import "../styles/tokens.css";
import "../styles/demos.css";
import SiteHeader from "../components/SiteHeader.astro";
import ThemeInit from "../components/ThemeInit.astro";
import SiteMeta from "../components/SiteMeta.astro";
import DocsSidebar from "../components/DocsSidebar.astro";
import CopyButtons from "../components/CopyButtons.astro";
import { sitePath } from "../lib/site-path.ts";

interface Props {
  title: string;
  description?: string | undefined;
  /** The page's path (`/start/`, `/playground/`, `/api/`), for the header's active link. */
  current: string;
  headings?: { depth: number; slug: string; text: string }[];
}

const { title, description, current, headings = [] } = Astro.props;
const hasNav = headings.some((h) => h.depth === 2);
---

<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SiteMeta
      title={`${title} — aared (عارض) | @aared/viewer`}
      description={description ?? "aared (عارض), published as @aared/viewer: TypeScript Office previews for PPTX, XLSX and DOCX in the browser, with Arabic/RTL fidelity."}
      current={current}
    />
    <link rel="icon" href={sitePath("/aared-mark.svg")} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <ThemeInit />
  </head>
  <body>
    <SiteHeader current={current} />
    <div class="docs-shell">
      <div class:list={["docs-card", { "has-nav": hasNav }]}>
        {hasNav && <DocsSidebar headings={headings} />}
        <main class="docs-content" data-copyable>
          <h1>{title}</h1>
          <slot />
        </main>
      </div>
    </div>
    <CopyButtons />
  </body>
</html>

<style is:global>
  :root {
    --docs-radius: 16px;
  }

  /* Docs pages use the full window width; the header follows so the
     wordmark and card edges line up. Pages with a sidebar go flush to the
     window edges; the rest float as a card with a gutter. */
  .docs-shell {
    flex: 1;
    width: 100%;
    padding: 0;
    box-sizing: border-box;
  }
  body:has(.docs-shell) .site-header-inner {
    max-width: none;
    padding-inline: 1.5rem;
  }

  /* ---- Content typography (shared by /api and /playground) ---- */
  .docs-content {
    min-width: 0;
    padding: 2rem 2.5rem 3rem;
    font-size: 1.0625rem;
    /* Legibility comes from size and full-contrast ink, not weight: 500 across
       a whole page of prose reads as one long bold line. `strong` still lifts. */
    font-weight: 400;
    line-height: 1.7;
    color: var(--lt-ink);
  }
  .docs-content h1:where(:not(.demo-stage *)) {
    font-family: var(--lt-font-display);
    font-size: var(--lt-step-3);
    line-height: 1.15;
    margin: 0 0 1rem;
  }
  .docs-content h2:where(:not(.demo-stage *)),
  .docs-content h3:where(:not(.demo-stage *)) {
    font-family: var(--lt-font-sans);
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--lt-ink);
    scroll-margin-top: 1.5rem;
  }
  .docs-content h2:where(:not(.demo-stage *)) {
    font-size: 1.85rem;
    line-height: 1.25;
    margin: 3.25rem 0 0.9rem;
  }
  .docs-content h3:where(:not(.demo-stage *)) {
    font-size: 1.3rem;
    line-height: 1.3;
    margin: 2.25rem 0 0.6rem;
  }
  .docs-content strong:where(:not(.demo-stage *)) {
    font-weight: 700;
  }
  .docs-content p:where(:not(.demo-stage *)),
  .docs-content li:where(:not(.demo-stage *)) {
    max-width: 80ch;
  }
  .docs-content code:where(:not(.demo-stage *)) {
    font-family: var(--lt-font-mono, ui-monospace, monospace);
    /* Plex Mono has a shorter x-height than Plex Sans, so it needs a little
       more size to sit level with the prose it interrupts. */
    font-size: 0.92em;
    font-weight: 500;
  }
  /* No chip behind inline code: where half a paragraph is type names, a filled
     box per token builds a brick wall and the horizontal padding breaks the
     line's rhythm. The mono face, the slate ink and the extra weight already
     separate code from prose — three signals, none of them a box. */
  .docs-content :not(pre) > code:where(:not(.demo-stage *)) {
    color: var(--lt-ink-code);
  }
  .docs-content :is(h2, h3) > code:where(:not(.demo-stage *)) {
    font-size: 0.85em;
    font-weight: 500;
  }
  .docs-content a:where(:not(.demo-stage *)) {
    color: var(--lt-accent);
  }

  /* Code blocks: rounded cards in the theme's code surface; the copy button is CopyButtons' */
  .docs-content .code-wrap:where(:not(.demo-stage *)) {
    margin: 1.25rem 0;
  }
  .docs-content pre:where(:not(.demo-stage *)) {
    overflow-x: auto;
    margin: 1.25rem 0;
    padding: 1.1rem 1.25rem;
    font-size: 0.87rem;
    font-weight: 400;
    line-height: 1.65;
    border-radius: var(--docs-radius);
    border: 1px solid var(--lt-code-edge);
    background-color: var(--lt-code) !important;
  }
  /* Wrapped blocks (the playground's): continuation lines hang two columns in */
  .docs-content pre[style*="pre-wrap"] .line:where(:not(.demo-stage *)) {
    display: inline-block;
    box-sizing: border-box;
    width: 100%;
    padding-inline-start: 2ch;
    text-indent: -2ch;
  }

  /* Callouts: an accent outline on the page colour, never a fill — filled
     boxes are code blocks, and a faint accent fill turns muddy on the dark
     page. A leading bold title takes the accent too. */
  .docs-content blockquote:where(:not(.demo-stage *)) {
    margin: 1.25rem 0;
    padding: 0.9rem 1.25rem;
    border: 1px solid var(--lt-accent);
    border-radius: var(--docs-radius);
    background: transparent;
    color: var(--lt-ink);
  }
  .docs-content blockquote > p:first-child > strong:first-child {
    color: var(--lt-accent);
  }
  .docs-content blockquote > :first-child {
    margin-top: 0;
  }
  .docs-content blockquote > :last-child {
    margin-bottom: 0;
  }

  /* Tables: rounded outline, row rules only */
  .docs-content table:where(:not(.demo-stage *)) {
    display: block;
    overflow-x: auto;
    border: 1px solid var(--lt-mount-edge);
    border-radius: var(--docs-radius);
    border-collapse: separate;
    border-spacing: 0;
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 1.25rem 0;
  }
  .docs-content th:where(:not(.demo-stage *)),
  .docs-content td:where(:not(.demo-stage *)) {
    border-bottom: 1px solid var(--lt-mount-edge);
    padding: 0.55rem 0.9rem;
    text-align: start;
    vertical-align: top;
  }
  .docs-content th:where(:not(.demo-stage *)) {
    background: color-mix(in srgb, var(--lt-mount-edge) 55%, transparent);
    white-space: nowrap;
  }
  .docs-content tbody tr:last-child td:where(:not(.demo-stage *)) {
    border-bottom: 0;
  }

  /* ---- Docs window: rounded card holding sidebar + content ---- */
  .docs-card {
    margin: 1.5rem 0 0;
    background: var(--lt-mount);
    border: 1px solid var(--lt-mount-edge);
    border-inline: 0;
    border-bottom: 0;
    border-radius: 24px 24px 0 0;
  }
  .docs-card.has-nav {
    display: grid;
    grid-template-columns: 16rem minmax(0, 1fr);
  }

  .docs-nav {
    position: sticky;
    top: 1rem;
    align-self: start;
    max-height: calc(100vh - 2rem);
    overflow-y: auto;
    margin: 1rem 0 1rem 1rem;
    padding: 0.25rem 0.75rem 0.25rem 0;
    border-inline-end: 1px solid var(--lt-mount-edge);
    font-size: 0.9rem;
    font-weight: 500;
  }
  .docs-nav-search {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.75rem;
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--lt-mount-edge) 55%, transparent);
    color: var(--lt-ink-soft);
  }
  .docs-nav-search:focus-within {
    outline: 2px solid var(--lt-accent);
    outline-offset: 2px;
  }
  .docs-nav-search input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: none;
    color: var(--lt-ink);
    font: inherit;
    outline: none;
  }
  .docs-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .docs-nav details > ul {
    margin: 0.1rem 0 0.4rem 0.6rem;
  }
  .docs-nav summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem;
    cursor: pointer;
    list-style: none;
  }
  .docs-nav summary::-webkit-details-marker {
    display: none;
  }
  .docs-nav summary::after {
    content: "";
    flex: none;
    width: 0.4rem;
    height: 0.4rem;
    margin-inline-end: 0.7rem;
    border-right: 2px solid var(--lt-ink-soft);
    border-bottom: 2px solid var(--lt-ink-soft);
    transform: rotate(45deg);
    transition: transform 0.12s;
  }
  .docs-nav details[open] > summary::after {
    transform: rotate(-135deg);
  }
  .docs-nav summary > a {
    flex: 1;
  }
  .docs-nav a {
    display: block;
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    color: var(--lt-ink);
    text-decoration: none;
    line-height: 1.35;
  }
  .docs-nav summary > a,
  .docs-nav a.docs-nav-solo {
    font-weight: 700;
  }
  .docs-nav a:hover {
    background: color-mix(in srgb, var(--lt-ink) 7%, transparent);
  }
  .docs-nav a:focus-visible {
    outline: 2px solid var(--lt-accent);
    outline-offset: 1px;
  }
  .docs-nav a[aria-current] {
    background: var(--lt-mount-edge);
    color: var(--lt-ink);
    font-weight: 600;
  }
  .docs-nav-empty {
    margin: 0.5rem 0.8rem;
    color: var(--lt-ink-soft);
  }

  @media (max-width: 60rem) {
    .docs-card.has-nav {
      grid-template-columns: minmax(0, 1fr);
    }
    .docs-nav {
      position: static;
      max-height: 14rem;
      margin: 1rem 1rem 0;
      padding: 0 0 1rem;
      border-inline-end: 0;
      border-bottom: 1px solid var(--lt-mount-edge);
    }
    .docs-content {
      padding: 1.5rem 1.25rem 2.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .docs-nav summary::after {
      transition: none;
    }
  }
</style>
