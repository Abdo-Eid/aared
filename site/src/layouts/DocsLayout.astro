---
import "../styles/tokens.css";
import "../styles/demos.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import ThemeInit from "../components/ThemeInit.astro";

interface Props {
  title: string;
  description?: string;
  current: "/" | "/playground/" | "/api/";
}

const { title, description, current } = Astro.props;
---

<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — aared</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <ThemeInit />
  </head>
  <body>
    <SiteHeader current={current} />
    <main class="docs-content">
      <h1>{title}</h1>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  .docs-content {
    flex: 1;
    width: 100%;
    max-width: 64rem;
    margin: 0 auto;
    padding: 2.5rem 1.25rem 4rem;
    box-sizing: border-box;
    font-size: 1rem;
    line-height: 1.65;
  }
  .docs-content h1 {
    font-family: var(--lt-font-display);
    font-size: var(--lt-step-3);
    line-height: 1.15;
    margin: 0 0 1rem;
  }
  .docs-content h2 {
    font-family: var(--lt-font-display);
    font-size: var(--lt-step-2);
    margin: 2.5rem 0 0.75rem;
  }
  .docs-content h3 {
    font-size: 1.2rem;
    margin: 1.75rem 0 0.5rem;
  }
  .docs-content p {
    max-width: 68ch;
  }
  .docs-content pre {
    overflow-x: auto;
    font-size: 0.85rem;
  }
  .docs-content code {
    font-family: var(--lt-font-mono, ui-monospace, monospace);
    font-size: 0.9em;
  }
  .docs-content :not(pre) > code {
    background: var(--lt-mount-edge);
    border-radius: 3px;
    padding: 0.1em 0.35em;
  }
  .docs-content a {
    color: var(--lt-amber);
  }
  .docs-content table {
    border-collapse: collapse;
    display: block;
    overflow-x: auto;
    font-size: 0.9rem;
  }
  .docs-content th,
  .docs-content td {
    border: 1px solid var(--lt-mount-edge);
    padding: 0.4rem 0.75rem;
    text-align: start;
    vertical-align: top;
  }
  .docs-content th {
    background: var(--lt-mount);
  }
</style>
