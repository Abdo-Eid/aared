---
/**
 * The bespoke home page — owns `/` directly. Shares tokens, header,
 * footer, and theme behavior with the docs routes so `/`, `/playground`,
 * and `/api` read as one theme.
 */
import Code from "astro/components/Code.astro";
import LightTable from "../components/LightTable.astro";
import NumbersSection from "../components/NumbersSection.astro";
import type { Benchmarks } from "../lib/benchmarks.ts";
import SiteHeader from "../components/SiteHeader.astro";
import ThemeInit from "../components/ThemeInit.astro";
import CopyButtons from "../components/CopyButtons.astro";
import { sitePath } from "../lib/site-path.ts";
import "../styles/tokens.css";
import { codeThemes } from "../lib/code-themes.ts";
import pptxUrl from "../../../fixtures/post-production-review.pptx?url";
import xlsxUrl from "../../../fixtures/post-production-tracker.xlsx?url";
import docxUrl from "../../../fixtures/docx-coverage.docx?url";

// One post-production file per format. No post-production .docx exists in
// fixtures/, so the Arabic bidi-coverage file stands in for that slot.
const fixtures = [
  { label: "Post-production review", url: pptxUrl, format: "pptx" },
  { label: "Post-production tracker", url: xlsxUrl, format: "xlsx" },
  { label: "Arabic document", url: docxUrl, format: "docx" },
];

// Generated by `bun run tools bench report --site`. Optional: without
// it the "By the numbers" section is simply left out.
const benchmarks = Object.values(
  import.meta.glob<Benchmarks>("../data/benchmarks.json", { eager: true, import: "default" }),
)[0];

// The install card under the live preview: the preview already shows package
// use, so this adds only the standard npm install command.
const installCode = [
  "npm install @aared/viewer",
].join("\n");
---

<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>aared — Office file preview built with Arabic in mind</title>
    <meta
      name="description"
      content="Preview real PowerPoint, Excel, and Word files in the browser — built with Arabic in mind. Real DOM/SVG, never canvas."
    />
    <link rel="icon" href={sitePath("/aared-mark.svg")} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <ThemeInit />
  </head>
  <body>
    <SiteHeader current="/" />

    <main>
      <section class="hero">
        <h1 lang="ar" dir="rtl">عارض</h1>
        <p class="tagline">
          Preview real PowerPoint, Excel, and Word files in the browser —
          built with Arabic in mind.
        </p>
        <p class="hero-sub">One package for every Office file. Use all of it, or only the part you need.</p>
      </section>

      <figure class="launch-video">
        <video
          src={sitePath("/media/aared-launch.webm")}
          poster={sitePath("/media/aared-launch-poster.jpg")}
          controls
          muted
          playsinline
          preload="metadata"
          width="1920"
          height="1080"
          aria-label="aared launch film: PowerPoint, Excel and Word files rendered in the browser as real text, in English and Arabic"
        ></video>
      </figure>

      <div data-copyable>
        <LightTable fixtures={fixtures} />
      </div>

      <p class="product-boundaries">
        PPTX, XLSX and DOCX, processed in your browser. Local files are not uploaded.
        View-only: no editing, conversion or formula recalculation.{' '}
        <a href={sitePath("/api/#fidelity-is-part-of-the-contract")}>Fidelity and limits</a>.
      </p>

      <section class="install" aria-labelledby="install-title" data-copyable>
        <h2 id="install-title">Install</h2>
        <Code code={installCode} lang="bash" themes={codeThemes} defaultColor={false} />
        <p class="install-note">
          <a href={sitePath("/start/")}>Get started</a>, or read
          <a href={sitePath("/llms.txt")}>plain Markdown</a> for agents.
        </p>
      </section>

      <section class="differentiator" aria-labelledby="why-title">
        <h2 id="why-title">Why aared</h2>
        <figure class="flow" role="img" aria-label="Files are parsed in a Worker into a resolved model, then rendered on the main thread to DOM and SVG, never canvas.">
          <div class="flow-lanes" aria-hidden="true">
            <div class="flow-lane" data-lane="Worker">
              <span class="flow-chip">.pptx .xlsx .docx</span>
              <span class="flow-arrow">→</span>
              <span class="flow-chip">Parse</span>
              <span class="flow-arrow">→</span>
              <span class="flow-chip">Resolved model</span>
            </div>
            <span class="flow-arrow">→</span>
            <div class="flow-lane" data-lane="Main thread">
              <span class="flow-chip">Render</span>
              <span class="flow-arrow">→</span>
              <span class="flow-chip flow-chip-end">DOM / SVG</span>
              <span class="flow-note">never <s>canvas</s></span>
            </div>
          </div>
        </figure>
        <p>
          <span>Canvas-based previewers turn text into pixels, making text selection and Arabic fidelity harder to preserve.</span>
          <span><strong>aared</strong> renders real DOM/SVG, so the browser's own text engine gets shaping, bidi and RTL right.</span>
        </p>
      </section>

      {benchmarks !== undefined && <NumbersSection data={benchmarks} />}

      <section class="next-steps">
        <a class="next-card" href={sitePath("/start/")}>
          <span class="next-card-kicker">set it up</span>
          <span class="next-card-title">Getting started</span>
          <span class="next-card-body">Install, pick an entry, copy a recipe, fix the usual first problems.</span>
        </a>
        <a class="next-card" href={sitePath("/playground/")}>
          <span class="next-card-kicker">try it</span>
          <span class="next-card-title">Playground</span>
          <span class="next-card-body">Try your own file in every way to use aared.</span>
        </a>
        <a class="next-card" href={sitePath("/api/")}>
          <span class="next-card-kicker">read it</span>
          <span class="next-card-title">API reference</span>
          <span class="next-card-body">Every function, option and event, in one page.</span>
        </a>
      </section>
    </main>
    <CopyButtons />
  </body>
</html>

<style>
  main {
    flex: 1;
    max-width: 64rem;
    margin: 0 auto;
    padding: 0 1.25rem 4rem;
    width: 100%;
    box-sizing: border-box;
  }

  /* Same two-ink treatment as the docs pages: mono face plus the slate code
     ink, no chip — see the note in DocsLayout. */
  code {
    font-family: var(--lt-font-mono, ui-monospace, monospace);
    color: var(--lt-ink-code);
    font-size: 0.92em;
    font-weight: 500;
  }

  .hero {
    padding-block: 2.5rem 2rem;
    max-width: 46rem;
  }
  /* The launch film, framed the way the film frames its document cards:
     a thick soft frame, round corners and a long soft shadow. The film's
     frame colour is --lt-ground itself, the page ground here, so the frame
     takes the deeper tone to stay visible. */
  .launch-video {
    margin: 0 0 2.5rem;
    border: 12px solid var(--lt-ground-deep);
    border-radius: 18px;
    overflow: hidden;
    background: #f5f2ec;
    box-shadow: 0 40px 72px rgba(28, 26, 24, 0.16), 0 8px 22px rgba(28, 26, 24, 0.08);
  }
  .launch-video video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
  }
  .hero h1 {
    font-family: var(--lt-font-display);
    font-size: var(--lt-step-4);
    line-height: 1.1;
    margin: 0 0 0.75rem;
  }
  /* Only small body copy takes the docs' medium weight — it compensates for
     size. Display text is already heavy enough at 400 and turns blocky above it. */
  .tagline {
    font-size: var(--lt-step-2);
    line-height: 1.4;
    margin: 0 0 1rem;
    color: var(--lt-ink);
  }
  .hero-sub {
    font-size: var(--lt-step-1);
    line-height: 1.6;
    color: var(--lt-ink-soft);
    max-width: 60ch;
  }

  .differentiator {
    display: grid;
    gap: 0.75rem;
    margin: 1.25rem 0 0;
    padding: 1.25rem;
    background: var(--lt-mount);
    border: 1px solid var(--lt-mount-edge);
    border-radius: var(--lt-radius);
  }
  .differentiator h2 {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 600;
  }
  /* The pipeline: two dashed lanes (where the work happens) of chips joined
     by arrows. Chips use the code surface; the result chip is outlined in
     the accent. On a phone the lanes stack and the arrows point down. */
  .flow {
    margin: 0;
    display: grid;
    gap: 0.5rem;
    font-family: var(--lt-font-mono, ui-monospace, monospace);
    font-size: 0.78rem;
  }
  .flow-lanes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }
  .flow-lane {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    padding: 0.9rem 0.75rem 0.7rem;
    border: 1px dashed color-mix(in srgb, var(--lt-ink) 35%, transparent);
    border-radius: 8px;
  }
  .flow-lane::before {
    content: attr(data-lane);
    position: absolute;
    top: -0.6rem;
    left: 0.7rem;
    padding: 0 0.4rem;
    background: var(--lt-mount);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--lt-ink-soft);
  }
  .flow-chip {
    padding: 0.35rem 0.65rem;
    background: var(--lt-code);
    border: 1px solid var(--lt-code-edge);
    border-radius: 6px;
    color: var(--lt-ink);
    white-space: nowrap;
  }
  .flow-chip-end {
    background: var(--lt-mount);
    border: 1.5px solid var(--lt-accent);
  }
  .flow-arrow {
    color: var(--lt-accent);
    line-height: 1;
  }
  .flow-note {
    font-size: 0.78rem;
    color: var(--lt-ink-soft);
    white-space: nowrap;
  }
  .flow-note s {
    color: var(--lt-accent);
  }
  @media (max-width: 44rem) {
    .flow-lanes {
      flex-direction: column;
      align-items: stretch;
    }
    .flow-lanes > .flow-arrow {
      align-self: center;
      transform: rotate(90deg);
    }
  }
  /* Two sentences, one per line on wide screens (each wraps on its own on a
     phone). */
  .differentiator p {
    margin: 0;
    font-size: 1.0625rem;
    font-weight: 500;
    line-height: 1.75;
  }
  .differentiator p span {
    display: block;
  }
  .differentiator p strong {
    font-weight: 700;
  }

  /* Install: one card right under the live preview. Title on top; on wide
     screens the commands and the note sit side by side. */
  .install {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
    margin: 1.25rem 0 0;
    padding: 1.25rem;
    border: 1px solid var(--lt-mount-edge);
    border-radius: var(--lt-radius);
    background: var(--lt-mount);
  }
  @media (min-width: 44rem) {
    .install {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
      column-gap: 1.5rem;
    }
    .install h2 {
      grid-column: 1 / -1;
    }
  }
  .install h2 {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 600;
  }
  .install :global(pre.astro-code) {
    margin: 0;
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--lt-code-edge);
    border-radius: var(--lt-radius);
    background: var(--lt-code) !important;
    font-size: 0.82rem;
    line-height: 1.65;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .install :global(pre.astro-code code) {
    font-family: var(--lt-font-mono, ui-monospace, monospace);
  }
  .install-note {
    margin: 0;
    font-size: 0.92rem;
    font-weight: 500;
    line-height: 1.6;
    color: var(--lt-ink-soft);
  }
  .install-note a {
    color: var(--lt-accent);
  }

  .next-steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin-top: 1.25rem;
  }
  @media (max-width: 40rem) {
    .next-steps {
      grid-template-columns: 1fr;
    }
  }
  .next-card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.25rem;
    border: 1px solid var(--lt-mount-edge);
    border-radius: var(--lt-radius);
    background: var(--lt-mount);
    color: var(--lt-ink);
    text-decoration: none;
  }
  .next-card:hover,
  .next-card:focus-visible {
    border-color: var(--lt-accent);
    outline: none;
  }
  .next-card-kicker {
    font-family: var(--lt-font-mono, ui-monospace, monospace);
    font-size: 0.7rem;
    color: var(--lt-accent-glow);
  }
  .next-card-title {
    font-size: 1.15rem;
    font-weight: 600;
  }
  .next-card-body {
    color: var(--lt-ink);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.65;
  }
</style>
