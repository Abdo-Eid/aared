---
/**
 * Every docs page (`src/content/docs/*.mdx`) at `/<name>/`: Start, Playground,
 * API reference. A page lists its headings in a sidebar unless its
 * frontmatter says `sidebar: false`.
 */
import { getCollection, render, type CollectionEntry } from "astro:content";
import DocsLayout from "../layouts/DocsLayout.astro";

export async function getStaticPaths() {
  const entries = await getCollection("docs");
  return entries.map((entry) => ({ params: { page: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<"docs">;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  current={`/${entry.id}/`}
  headings={entry.data.sidebar ? headings : []}
>
  <Content />
</DocsLayout>
