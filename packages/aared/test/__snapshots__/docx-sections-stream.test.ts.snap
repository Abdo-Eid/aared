      "markerRun": {
       "text": "—",
       "fontSizePt": 10.5,
       "language": "ar-SA",
       "color": "#B87F1E",
       "latinTypeface": "Arial",
       "complexScriptTypeface": "Arial",
       "fontFamily": "Arial"
      },
      "paragraph": {
       "type": "paragraph",
       "runs": [
        {
         "text": "الحفاظ على انتباه المشاهد خلال افتتاحية مدتها ست دقائق بلا تعليق صوتي.",
         "fontSizePt": 11,
