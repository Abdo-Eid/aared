   {
    "type": "paragraph",
    "runs": [
     {
      "text": "Dates below are hard for the picture lock and soft for everything upstream of it. If an interview slips, the assembly absorbs it; the lock does not move.",
      "fontSizePt": 10.5,
      "language": "ar-SA",
      "color": "#1B2029",
