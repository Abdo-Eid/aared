{
  "name": "aared-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "bench",
    "site"
  ],
  "scripts": {
    "dev": "bun run --cwd bench --no-orphans dev",
    "docs:dev": "bun run --cwd site --no-orphans dev",
    "docs:build": "bun run --cwd site build",
    "build": "bun --filter aared --filter aared-fonts build",
    "typecheck": "bun --filter '*' typecheck && bun run typecheck:tools",
    "typecheck:tools": "tsc --project tools/tsconfig.json",
    "tools": "bun tools/cli.ts",
    "test": "bun test",
    "test:visual": "bun tools/checks/visual-tests.ts",
    "test:visual:artifacts": "bun tools/checks/visual-tests.ts --artifacts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "typescript": "^7.0.2"
  }
}
